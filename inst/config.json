    "staging": { "api_url": "https://staging-api.survey160.com" },
    "dev": {}
  },
  "datasets": {
    "campaign_results": {
      "prod": { "bucket": "campaign_results" },
      "staging": { "bucket": "campaign_results_staging" }
    },
    "disposition": {
      "prod": {
        "bucket": "s160_disposition_prod",
        "object": "disposition_by_phone/disposition_all.parquet"
      },
      "dev": {
        "bucket": "s160_disposition_dev",
        "object": "disposition_by_phone/disposition_all.parquet"
      }
    },
    "opt_out": {
      "prod": {
        "bucket": "s160_disposition_prod",
        "object": "global_opt_out/global_opt_out.parquet"
      },
      "dev": {
        "bucket": "s160_disposition_dev",
        "object": "global_opt_out/global_opt_out.parquet"
      }
    }
  }
}
